# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact form email provider (all optional) ----
# The site works with no email provider configured; contact
# submissions are simply logged server-side until one is added.
EMAIL_PROVIDER=none            # none | gmail | future-provider

# Gmail provider (only read if EMAIL_PROVIDER=gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# ---- Future database (not used yet, reserved) ----
DATABASE_URL=
